class_name SoundBankEntry extends Resource
## One sound of the SoundBank: what plays, on which ADR-0013 §1 bus, at what gain and pitch.
## Generated by tools/audio/export.py into data/audio/sound_bank.tres.

## The sound file (WAV one-shot or Ogg loop, mono, loudness-normalised per category).
@export var stream: AudioStream
## ADR-0013 §1 bus name (default_bus_layout.tres).
@export var bus: StringName = &"SFX"
## Player gain over the file's normalised level, dB.
@export var volume_db: float = 0.0
## Player pitch (per-survivor footstep sets share a file at different pitches).
@export var pitch_scale: float = 1.0
## The stream loops (ambience beds); applied to the stream when the bank resolves it.
@export var loop: bool = false
